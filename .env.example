# Groq API key for the AI chat assistant
# Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Passcode for /tools/playbook (AJ-only working notes)
# Pick anything; changing it locks out anyone who had the old one.
PLAYBOOK_PASSCODE=choose_a_passcode

# Random secret used to sign the playbook auth cookie
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLAYBOOK_COOKIE_SECRET=long_random_hex_string
